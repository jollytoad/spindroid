<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The capture of the system audio and of the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The foreground service that keeps the capture alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- The notification that shows the state of the capture. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The server is on the local network. -->
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        tools:targetApi="36" />

    <!-- The keys are bound to the device keystore, so a restored copy is
         useless. Turn the backup off, so a restore never leaves the app with
         keys that it cannot decrypt. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SendSpin">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SendSpinService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

    </application>

</manifest>
