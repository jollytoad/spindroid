<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android requires a permission of the connected-device group for a
         foreground service of that type, which the listener uses. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- The capture of the system audio. Android asks for this permission
         for a record that reads what the system is playing. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The foreground service that keeps the capture alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- The notification that shows the state of the capture. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The server is on the local network. -->
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        tools:targetApi="36" />

    <!-- The finder of the Source card reads which apps carry a media
         browser service. Without this declaration the package manager
         answers an empty list, and it does not say so. -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <!-- The keys are bound to the device keystore, so a restored copy is
         useless. Turn the backup off, so a restore never leaves the app with
         keys that it cannot decrypt. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SendSpin">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SendSpinService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|connectedDevice" />

        <!-- The listener that hands the media sessions to the Source card.
             The system binds to it, and the user grants the access once. -->
        <service
            android:name=".capture.PlayingAppsListener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
