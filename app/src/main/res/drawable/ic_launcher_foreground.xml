<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher mark: the SendSpin Sender logo, a circle split into
    three pieces that share one centre.

    The robot head is a half-disc whose flat chin is the diameter cut
    at -44.3 degrees, the same tilt the app icon has always used. The
    eyes are holes, so the brand background shows through them, and
    the monochrome layer of the themed icon renders them the same way.
    Two thick arcs sweep the lower half, in the band weights of the
    SendSpin logo: every band and every gap is 7.6 wide, with round
    tips that stop short of the chin line. The negative space runs as
    one channel: chin gap, between the bands, through the centre, and
    out the other side. The left and right bracket arcs of the SendSpin
    logo are gone.

    The coordinates are the ones from art/logo.svg, the source of
    truth for the mark. The group centres the drawing on the launcher
    tile and scales it so the antennae stay inside the 66 dp safe
    zone: the farthest point sits 50.2 units from the centre, which
    lands at 27.6 dp at this scale.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.55"
        android:scaleY="0.55"
        android:translateX="54"
        android:translateY="54">

        <!-- The robot head: half-disc on the upper side of the chin
             diameter, with two eye holes (fillType evenOdd). -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M24.20,-23.60 A33.8,33.8 0 0 0 -24.20,23.60 Z M1.58,-14.97 A4.22,4.22 0 1 0 -6.86,-14.97 A4.22,4.22 0 1 0 1.58,-14.97 Z M-10.68,-3.01 A4.22,4.22 0 1 0 -19.13,-3.01 A4.22,4.22 0 1 0 -10.68,-3.01 Z" />

        <!-- The antennae, radial to the head at 30 degrees either
             side of its axis. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5.5"
            android:strokeLineCap="round"
            android:pathData="M-8.30,-32.76 L-11.65,-45.97 M-32.55,-9.12 L-45.66,-12.80" />

        <!-- The two lower arcs of the split circle, centreline strokes
             of width 7.6 with round tips. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7.6"
            android:strokeLineCap="round"
            android:pathData="M27.75,-11.41 A30,30 0 0 1 -12.10,27.45" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7.6"
            android:strokeLineCap="round"
            android:pathData="M14.30,-3.80 A14.8,14.8 0 0 1 -4.16,14.20" />
    </group>
</vector>
