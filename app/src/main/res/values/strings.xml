    <string name="title_pairing">Pairing</string>
    <string name="pairing_explanation">Paste this token into Music Assistant, on the screen where a new input is paired. The token never changes, so the same one works for every server.</string>
    <string name="pairing_done">The phone is paired. It shows up under Live Inputs in Music Assistant, where the user picks it as the input for a player or a group.</string>
