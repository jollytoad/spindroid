    <!-- The main screen. -->
    <string name="title_start">Send to Music Assistant</string>
    <string name="start_explanation">The phone sends the sound it plays. Music Assistant finds the phone on the local network, so both must be on the same network.</string>
    <string name="action_connect">Connect</string>
    <string name="action_disconnect">Disconnect</string>
